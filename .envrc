# Load the Nix dev shell of flake.nix.
# Run `direnv allow` one time to approve this file.

# nix-direnv caches the dev shell and protects it from the garbage collector.
# Plain direnv works too, but it evaluates the flake on every directory entry.
if ! has nix_direnv_version; then
  echo "direnv: nix-direnv is not active. The shell reloads more slowly." >&2
  echo "direnv: on NixOS set programs.direnv.enable = true." >&2
fi

use flake

# Watch the files that change the shell.
watch_file flake.nix
watch_file flake.lock

# Put project binaries first on PATH.
PATH_add target/debug
PATH_add frontend/node_modules/.bin

# Local overrides stay out of git. Put machine settings in .envrc.local.
dotenv_if_exists .envrc.local
